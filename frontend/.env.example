# Production / Vercel: use same-origin API rewrite (recommended)
NEXT_PUBLIC_API_URL=/api

# Local alternative (direct FastAPI, bypasses Next rewrite):
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Optional local Next.js rewrite target (used only when VERCEL is unset)
# BACKEND_PROXY_URL=http://127.0.0.1:8000
